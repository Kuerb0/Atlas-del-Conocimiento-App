    nac = pd.to_datetime(["1950-06-30"] * 2); ini = pd.to_datetime(["2020-01-01"] * 2); fin = pd.to_datetime(["2021-12-31", "2020-06-30"])
    e = exposicion_por_edad(pd.DataFrame({"n": nac, "i": ini, "f": fin, "e": [0, 1]}), "n", "i", "f", "e")
