    escribir(lec, [['Media de x ', [f(mx, 2)], ' · media de y ', [f(my, 2)], ' · varianza de x ', [f(sxx / (n - 1), 2)], ' · varianza de y ', [f(syy / (n - 1), 2)]],
      ['Correlación ', [f(r, 3)], ' · recta: y = ', [f(a, 2) + ' + ' + f(b, 3) + ' x']],
