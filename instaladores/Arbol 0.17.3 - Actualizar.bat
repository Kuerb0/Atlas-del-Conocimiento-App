def celdas_de(funcion: str) -> list[str] | None:
    """Celdas listas para ejecutar: [escenario, ...celdas de la función]."""
    if funcion not in E:
        return None
    escenario, celdas = E[funcion]
    return [ESCENARIOS[escenario]] + list(celdas)


