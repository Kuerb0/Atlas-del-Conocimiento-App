/* ---------- selección y detalle ---------- */
function raizLocal() {
  if (location.protocol === 'file:') {
    var p = decodeURIComponent(location.pathname).replace(/^\/([A-Za-z]:)/, '$1'); return p.replace(/\/[^\/]*$/, '');
  }
  return DATA.raiz;
}
function rutaAbs(rel) { var r = raizLocal(), win = /^[A-Za-z]:|\\/.test(r), base = r.replace(/[\\\/]+$/, ''); return win ? base.replace(/\//g, '\\') + '\\' + rel.replace(/\//g, '\\') : base + '/' + rel; }
function urlVsCode(rel, linea) { return 'vscode://file/' + encodeURI(rutaAbs(rel).replace(/\\/g, '/')) + ':' + (linea || 1); }
function resaltar(src) {
  var re = /(#[^\n]*)|("""[\s\S]*?"""|'''[\s\S]*?'''|"(?:\\.|[^"\\\n])*"|'(?:\\.|[^'\\\n])*')|\b(def|return|import|from|if|else|elif|for|in|while|try|except|raise|with|as|and|or|not|is|None|True|False|lambda|class|yield|continue|break|pass)\b|\b(\d+\.?\d*)\b/g;
  var out = '', last = 0, m;
  while ((m = re.exec(src))) {
    out += esc(src.slice(last, m.index));
    var cl = m[1] ? 'c' : m[2] ? 's' : m[3] ? 'k' : 'num';
    out += '<span class="' + cl + '">' + esc(m[0]) + '</span>'; last = re.lastIndex;
  }
  return out + esc(src.slice(last));
}
function copiar(texto, msg) {
  function ok() { aviso(msg || 'Copiado'); }
  function plan_b() {
    var ta = document.createElement('textarea'); ta.value = texto; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); ok(); } catch (e) { aviso('No se pudo copiar: selecciona el texto manualmente'); } document.body.removeChild(ta);
