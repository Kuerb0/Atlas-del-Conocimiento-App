def _dg(n, s=0):
    r = _r(n, s)
    d = pd.DataFrame({"a": r.choice(list("xyz"), n), "b": r.choice(list("pq"), n), "x": r.normal(size=n), "w": r.normal(size=n)})
    d["y"] = (d.a == "z") + d.x + 0.5 * d.x * d.w + r.normal(size=n)
    d["t"] = (r.random(n) < 1 / (1 + np.exp(-d.x))).astype(int)
    return d


