/* ---------- «Probar»: cuaderno por celdas (se ejecuta en Python a través de la app, py/arbol_app.pyw) ---------- */
var sesionesNB = {};          /* función -> nº de celdas ya ejecutadas en la sesión de Python */
window.addEventListener('pywebviewready', function () { document.querySelectorAll('.nb-nota').forEach(function (e) { e.remove(); }); });
function hayPython() { return !!(window.pywebview && window.pywebview.api && window.pywebview.api.ejecutar); }
function cuaderno(n, caja) {
  var ses = 'fn:' + n.rid, celdas = n.ejemplo.slice(), eds = [], sals = [], ocupado = false;
  var barra = document.createElement('div'); barra.className = 'nb-barra'; caja.appendChild(barra);
  function boton(t, fn, tit) { var b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = t; if (tit) b.title = tit; b.onclick = fn; barra.appendChild(b); return b; }
  boton('▶ Ejecutar todo', function () { correrHasta(celdas.length - 1); }, 'Ejecuta todas las celdas en orden');
  boton('↺ Reiniciar', function () { if (hayPython()) window.pywebview.api.reiniciar(ses); sesionesNB[ses] = 0; sals.forEach(function (s) { s.innerHTML = ''; }); estado('Sesión reiniciada.'); }, 'Borra las variables y empieza de cero');
  boton('Copiar todo', function () { copiar(eds.map(function (e) { return e.value; }).join('\n\n'), 'Celdas copiadas'); });
  var est = document.createElement('span'); est.className = 'nb-estado'; barra.appendChild(est);
  function estado(t) { est.textContent = t; }
  if (!hayPython()) {
    var nota = document.createElement('p'); nota.className = 'nb-nota';
    nota.textContent = 'Para ejecutar las celdas abre el árbol desde su acceso directo (la app). Aquí puedes leerlas, editarlas y copiarlas a tu notebook.';
    caja.appendChild(nota);
  }
  celdas.forEach(function (c, i) {
    var cel = document.createElement('div'); cel.className = 'nb-celda';
    var cab = document.createElement('div'); cab.className = 'nb-cab';
    var et = document.createElement('span'); et.textContent = i === 0 ? '[datos simulados]' : '[' + i + ']'; cab.appendChild(et);
    var b = document.createElement('button'); b.type = 'button'; b.className = 'btn'; b.textContent = '▶'; b.title = 'Ejecutar esta celda (Ctrl+Enter)';
    b.onclick = function () { correrHasta(i); }; cab.appendChild(b);
    var ed = document.createElement('textarea'); ed.className = 'nb-ed'; ed.spellcheck = false; ed.value = c;
    ed.rows = Math.min(Math.max(c.split('\n').length, 2), 16);
    ed.addEventListener('keydown', function (ev) {
      if (ev.key === 'Enter' && (ev.ctrlKey || ev.shiftKey)) { ev.preventDefault(); correrHasta(i); }
      else if (ev.key === 'Tab') { ev.preventDefault(); var p = ed.selectionStart; ed.setRangeText('    ', p, ed.selectionEnd, 'end'); }
    });
    var sal = document.createElement('div'); sal.className = 'nb-sal';
    cel.appendChild(cab); cel.appendChild(ed); cel.appendChild(sal); caja.appendChild(cel); eds.push(ed); sals.push(sal);
  });
  function pintarSalida(sal, r) {
    sal.innerHTML = '';
    function pre(t, cls) { var p = document.createElement('pre'); if (cls) p.className = cls; p.textContent = t; sal.appendChild(p); }
    if (r.salida) pre(r.salida);
    if (r.html) { var dv = document.createElement('div'); dv.innerHTML = r.html; sal.appendChild(dv); }
    if (r.texto) pre(r.texto);
    (r.imagenes || []).forEach(function (b64) { var im = document.createElement('img'); im.alt = 'gráfico'; im.src = 'data:image/png;base64,' + b64; sal.appendChild(im); });
    if (r.error) pre(r.error, 'err');
  }
  async function correrHasta(i) {
    if (!hayPython()) { estado('Abre el árbol desde la app para ejecutar.'); return; }
    if (ocupado) return; ocupado = true;
    var desde = Math.min(sesionesNB[ses] || 0, i);        /* ejecuta antes las celdas previas que falten */
    try {
      for (var k = desde; k <= i; k++) {
        estado('Ejecutando celda ' + (k === 0 ? 'de datos' : k) + '…'); sals[k].innerHTML = '<pre>…</pre>';
