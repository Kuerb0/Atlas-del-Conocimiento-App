  leyenda(cont, [['dm-k1', 'carteras posibles'], ['dm-k2', 'tu cartera'], ['dm-km', 'mínima varianza']]);
  var lec = lectura(cont);
  function sd(w, r) { return Math.sqrt(Math.max((1 - w) * (1 - w) * A.s * A.s + w * w * B.s * B.s + 2 * w * (1 - w) * r * A.s * B.s, 0)); }
